# ---- Corte API (server) env ----
PORT=4000
NODE_ENV=production

# CORS: comma-separated web origins allowed (your Vercel URL). '*' = dev only.
CORS_ORIGINS=https://cortes.digital,https://www.cortes.digital

# Bootstrap super-admin(s) — always admin regardless of Firebase claims
ADMIN_EMAILS=redcanidsvinicius@gmail.com,perdibitcoin@gmail.com
# Bootstrap super-admin by Firebase UID (always admin, regardless of claims/email)
ADMIN_UID=PKrc1M1Fhdceq0Y83BueSMKTPQe2

# Server pepper for hashing device ids (generate a random 48-hex string)
DEVICE_HASH_SECRET=change-me-to-a-long-random-string

# Firebase Admin credentials — EITHER the base64 of the whole service-account
# JSON (preferred), OR the three individual fields below.
FIREBASE_PROJECT_ID=corte-69134
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@corte-69134.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# IP geolocation via ipapi.co (public IPs only)
GEO_LOOKUP=true

# Optional: path to yt-dlp binary for link/profile video import.
# The server also auto-detects a binary bundled at apps/server/bin/yt-dlp.
# YTDLP_PATH=yt-dlp
# Cookies for sites that block anonymous access (Instagram, TikTok…):
#   YTDLP_COOKIES=/path/to/cookies.txt            (exported from a browser)
#   YTDLP_COOKIES_FROM_BROWSER=chrome|edge|brave|firefox   (backend on the
#     user's own machine; close the browser first on Windows)
# YTDLP_COOKIES=
# YTDLP_COOKIES_FROM_BROWSER=

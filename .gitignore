# deps
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
apps/web/dist/
apps/server/dist/

# env / secrets  (NEVER commit these)
.env
.env.local
.env.*.local
*.serviceaccount.json
serviceAccount*.json
firebase-adminsdk*.json

# vercel / render
.vercel/
.render/

# artefato de build do instalador (a cópia servida fica em apps/web/public)
installer/*.exe

# carimbo de versão gravado pelo auto-update no PC do usuário (runtime)
/version.json

# logs
*.log
npm-debug.log*
logs/

# runtime scratch (uploads, rendered clips, tmp media)
.data/
apps/server/.data/
apps/server/tmp/
apps/server/uploads/

# editor / os
.DS_Store
Thumbs.db
.idea/
*.tsbuildinfo
